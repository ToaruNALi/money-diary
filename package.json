{
  "name": "money-diary",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 8080 --no-hmr",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:analyze": "ng build --stats-json",
    "build:prod:analyze": "ng build --prod --stats-json",
    "analyze:only": "webpack-bundle-analyzer dist/money-diary/stats.json",
    "analyze": "npm run build:analyze && npm run analyze:only",
    "analyze:prod": "npm run build:prod:analyze && npm run analyze:only"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^19.1.0",
    "@angular/animations": "^19.2.1",
    "@angular/cdk": "^19.2.2",
    "@angular/common": "^19.2.1",
    "@angular/compiler": "^19.2.1",
    "@angular/core": "^19.2.1",
    "@angular/forms": "^19.2.1",
    "@angular/material": "^19.2.2",
    "@angular/platform-browser": "^19.2.1",
    "@angular/platform-browser-dynamic": "^19.2.1",
    "@angular/platform-server": "^19.2.1",
    "@angular/router": "^19.2.1",
    "@angular/ssr": "^19.2.1",
    "@google-cloud/local-auth": "^3.0.1",
    "@holiday-jp/holiday_jp": "^2.4.0",
    "@ngrx/effects": "^19.0.1",
    "@ngrx/entity": "^19.0.1",
    "@ngrx/operators": "^19.0.1",
    "@ngrx/router-store": "^19.0.1",
    "@ngrx/signals": "^19.0.1",
    "@ngrx/store": "^19.0.1",
    "@ngrx/store-devtools": "^19.0.1",
    "ag-charts-angular": "11.1.1",
    "ag-charts-community": "11.1.1",
    "ag-grid-angular": "^33.1.1",
    "ag-grid-community": "^33.1.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.1.0",
    "googleapis": "^146.0.0",
    "moji": "^0.5.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.1",
    "@angular/cli": "^19.2.1",
    "@angular/compiler-cli": "^19.2.1",
    "@types/moji": "^0.5.3",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
