{
  "name": "money-diary",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 8080 --no-hmr",
    "start:prod": "ng serve --port 8080 --prod --no-hmr",
    "build": "ng build",
    "build:prod": "ng build --prod",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:analyze": "ng build --stats-json",
    "build:prod:analyze": "ng build --prod --stats-json",
    "analyze:only": "webpack-bundle-analyzer dist/money-diary/stats.json",
    "analyze": "npm run build:analyze && npm run analyze:only",
    "analyze:prod": "npm run build:prod:analyze && npm run analyze:only"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^20.6.0",
    "@angular/animations": "^21.0.8",
    "@angular/cdk": "^21.0.6",
    "@angular/common": "^21.0.8",
    "@angular/compiler": "^21.0.8",
    "@angular/core": "^21.0.8",
    "@angular/forms": "^21.0.8",
    "@angular/material": "^21.0.6",
    "@angular/platform-browser": "^21.0.8",
    "@angular/platform-browser-dynamic": "^21.0.8",
    "@angular/platform-server": "^21.0.8",
    "@angular/router": "^21.0.8",
    "@angular/ssr": "^21.0.5",
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/entity": "^21.0.1",
    "@ngrx/operators": "^21.0.1",
    "@ngrx/router-store": "^21.0.1",
    "@ngrx/signals": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@ngrx/store-devtools": "^21.0.1",
    "ag-charts-angular": "13.0.0",
    "ag-charts-community": "13.0.0",
    "ag-grid-angular": "^35.0.0",
    "ag-grid-community": "^35.0.0",
    "date-fns": "^4.1.0",
    "moji": "^0.5.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.8",
    "@types/moji": "^0.5.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "webpack-bundle-analyzer": "^5.1.1"
  }
}
